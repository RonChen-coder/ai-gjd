    {
      "name": "管理端删除高基地信息",
      "description": "删除高基地信息，siteId 使用集合变量。",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/admin/site-info/delete?siteId={{siteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "site-info",
            "delete"
          ],
          "query": [
            {
              "key": "siteId",
              "value": "{{siteId}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "管理端查询高基地信息列表",
      "description": "支持按属地区编码或状态过滤，不传条件时查看全部。",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/admin/site-info/list?districtCode={{districtCode}}&status={{status}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "site-info",
            "list"
          ],
          "query": [
            {
              "key": "districtCode",
              "value": "{{districtCode}}"
            },
            {
              "key": "status",
              "value": "{{status}}"
            }
          ]
        }
      },
      "response": []
    },
