{
  "info": {
    "_postman_id": "1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d",
    "name": "高基地年报计划企业端 RecruitSiteAnnualPlanCorpController",
    "description": "企业填报年度计划并提交审核，待审核状态不能修改。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "新增或修改年报计划",
      "description": "字段说明：\n- annualYear：年度年份，必填\n- skillServiceCount：技能服务数，人次，必填\n- openServiceCount：面向社会开放服务数，人次，必填\n- situationDesc：上传情况说明，非必填\n- planFileKey：年度计划文件存储key，必填\n- planFileName：年度计划文件名称\n- serviceRatio：由服务端自动计算",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/corp/site-annual-plan/save",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "corp",
            "site-annual-plan",
            "save"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"annualYear\": \"2026\",\n  \"skillServiceCount\": 800,\n  \"openServiceCount\": 200,\n  \"situationDesc\": \"年度计划情况说明\",\n  \"planFileKey\": \"{{planFileKey}}\",\n  \"planFileName\": \"年度计划.pdf\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "分页查询本单位年报计划",
      "description": "企业端自动限定当前单位基地，无需传 siteId。字段说明：\n- annualYear：年度年份\n- status：审核状态\n- keyword：检索基地名称、年份",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/corp/site-annual-plan/list",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "corp",
            "site-annual-plan",
            "list"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"annualYear\": \"2026\",\n  \"status\": \"待审核\",\n  \"pageParam\": {\n    \"pageNum\": 1,\n    \"pageSize\": 10\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "查询本单位年报计划详情",
      "description": "按年报计划ID查询详情。",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/corp/site-annual-plan/detail?planId={{planId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "corp",
            "site-annual-plan",
            "detail"
          ],
          "query": [
            {
              "key": "planId",
              "value": "{{planId}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "导出本单位年报计划",
      "description": "企业端导出年报计划Excel，自动限定当前单位基地。字段说明：\n- annualYear：年度年份\n- status：审核状态\n- keyword：检索基地名称、年份",
      "request": {
        "method": "POST",
        "header": [
