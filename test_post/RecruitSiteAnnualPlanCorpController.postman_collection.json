            "export"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"annualYear\": \"2026\",\n  \"status\": \"待审核\",\n  \"keyword\": \"基地\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    }
