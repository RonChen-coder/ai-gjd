    "name": "高基地公告企业端 RecruitSiteNoticeCorpController",
    "description": "白名单内企业查看已发布公告的列表与详情接口。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "查询已发布公告列表",
      "description": "面向白名单内企业，仅展示状态为已发布的公告。",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/corp/site-notice",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "corp",
            "site-notice"
          ]
        }
      },
      "response": []
    },
    {
      "name": "查询已发布公告详情",
      "description": "面向白名单内企业，仅返回状态为已发布的公告，noticeId 使用集合变量。",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/corp/site-notice/{{noticeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "corp",
            "site-notice",
            "{{noticeId}}"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "noticeId",
      "value": "1",
      "type": "string"
    }
  ]
}
