{
  "info": {
    "_postman_id": "5f6e7d8c-9a0b-4d2e-af3b-4c5d6e7f8a9b",
    "name": "行为日志企业端 RecruitSiteBehaviorLogCorpController",
    "description": "白名单内单位查看本单位相关行为日志列表接口。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "查询行为日志列表",
      "description": "按业务对象类型和主键查询行为日志，bizType 取值为1基地、2项目、3资产。",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/corp/behavior-log/list?bizType={{bizType}}&bizId={{bizId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "corp",
            "behavior-log",
            "list"
          ],
          "query": [
            {
              "key": "bizType",
              "value": "{{bizType}}"
            },
            {
              "key": "bizId",
              "value": "{{bizId}}"
            }
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "bizType",
      "value": "1",
      "type": "string"
    },
    {
      "key": "bizId",
      "value": "1",
      "type": "string"
    }
  ]
}
