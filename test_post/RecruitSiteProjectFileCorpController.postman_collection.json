{
  "info": {
    "_postman_id": "d3e4c5b6-7f8a-4b9c-8d0e-1f2a3b4c5d6e",
    "name": "高基地项目文档企业端 RecruitSiteProjectFileCorpController",
    "description": "白名单单位维护当前单位项目文档，文件先通过通用上传接口获取key后再绑定到项目。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "企业端新增项目文档",
      "description": "先调用文件上传接口获取 fileStorageKey，再创建项目文档记录。",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/corp/site-project-file/upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "corp",
            "site-project-file",
            "upload"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"projectStatus\": \"1\",\n  \"fileName\": \"项目立项批复.pdf\",\n  \"fileDesc\": \"立项批复文件\",\n  \"fileStorageKey\": \"{{fileStorageKey}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "企业端修改项目文档",
      "description": "修改项目文档信息，可替换 fileStorageKey，旧文件存储会被删除。",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/corp/site-project-file/update",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "corp",
            "site-project-file",
            "update"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fileId\": \"{{fileId}}\",\n  \"projectStatus\": \"1\",\n  \"fileName\": \"项目立项批复.pdf\",\n  \"fileDesc\": \"更新后的立项批复文件\",\n  \"fileStorageKey\": \"{{fileStorageKey}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "企业端删除项目文档",
      "description": "删除项目文档记录并同步删除文件存储。",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/corp/site-project-file/delete?fileId={{fileId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "corp",
            "site-project-file",
            "delete"
          ],
          "query": [
            {
              "key": "fileId",
              "value": "{{fileId}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "企业端查询项目文档详情",
      "description": "查询当前单位项目文档详情。",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/corp/site-project-file/detail?fileId={{fileId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "corp",
            "site-project-file",
            "detail"
          ],
          "query": [
            {
              "key": "fileId",
              "value": "{{fileId}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "企业端查询项目文档列表",
      "description": "查询当前单位指定项目的文档列表。",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/corp/site-project-file/list?projectId={{projectId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "corp",
            "site-project-file",
            "list"
          ],
          "query": [
            {
              "key": "projectId",
              "value": "{{projectId}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "企业端下载项目文档",
      "description": "下载当前单位项目文档。",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/corp/site-project-file/download?fileId={{fileId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "corp",
            "site-project-file",
            "download"
          ],
          "query": [
            {
              "key": "fileId",
              "value": "{{fileId}}"
            }
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/ggzp-ywjb-shrs",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "fileId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "fileStorageKey",
      "value": "upload-file-key",
      "type": "string"
    }
  ]
}
