          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"noticeId\": \"{{noticeId}}\",\n  \"operatorName\": \"市级管理员\",\n  \"operatorId\": \"1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    }
