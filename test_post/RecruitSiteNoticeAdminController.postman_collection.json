{
  "info": {
    "_postman_id": "1f80e732-3cec-5370-8757-a6ab733adef6",
    "name": "高基地公告管理端 RecruitSiteNoticeAdminController",
    "description": "市级管理员公告的创建、更新、删除、查询、发布与下线接口。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "创建公告",
      "description": "市级管理员录入新的高基地公告草稿。",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/site-notice/create",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "site-notice",
            "create"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"noticeTitle\": \"2026年高基地培训项目申报通知\",\n  \"noticeContent\": \"各单位请于规定时间前完成项目申报。\",\n  \"publishDate\": \"2026-08-18T10:00:00\",\n  \"operatorName\": \"市级管理员\",\n  \"operatorId\": \"1\",\n  \"districtCode\": \"310115\",\n  \"status\": \"草稿\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "更新公告",
      "description": "市级管理员修改公告标题、正文等信息。",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/site-notice/update",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "site-notice",
            "update"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"noticeId\": \"{{noticeId}}\",\n  \"noticeTitle\": \"2026年高基地培训项目申报通知（更新）\",\n  \"noticeContent\": \"更新后的公告内容。\",\n  \"publishDate\": \"2026-08-18T10:00:00\",\n  \"operatorName\": \"市级管理员\",\n  \"operatorId\": \"1\",\n  \"districtCode\": \"310115\",\n  \"status\": \"草稿\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "删除公告",
      "description": "删除不再需要的公告记录，noticeId 使用集合变量。",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/admin/site-notice/delete?noticeId={{noticeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "site-notice",
            "delete"
          ],
          "query": [
            {
              "key": "noticeId",
              "value": "{{noticeId}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "查询全部公告",
      "description": "查看草稿、已发布和已下线等全部状态的公告。",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/admin/site-notice/list",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "site-notice",
            "list"
          ]
        }
      },
      "response": []
    },
    {
      "name": "查询公告详情",
      "description": "根据公告ID查询公告详情，noticeId 使用集合变量。",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/admin/site-notice/detail?noticeId={{noticeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "site-notice",
            "detail"
          ],
          "query": [
            {
              "key": "noticeId",
              "value": "{{noticeId}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "发布公告",
      "description": "发布后企业端可见该公告。",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/site-notice/publish",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "site-notice",
            "publish"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"noticeId\": \"{{noticeId}}\",\n  \"operatorName\": \"市级管理员\",\n  \"operatorId\": \"1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
